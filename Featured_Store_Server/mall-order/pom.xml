<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.preferredmall</groupId>
        <artifactId>Featured_Store_Server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>mall-order</artifactId>
    <packaging>jar</packaging>
    <name>mall-order</name>
    <description>订单域：购物车、下单编排、订单状态机、物流轨迹</description>

    <dependencies>
        <dependency>
            <groupId>com.preferredmall</groupId>
            <artifactId>mall-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.preferredmall</groupId>
            <artifactId>mall-infra</artifactId>
        </dependency>
        <dependency>
            <groupId>com.preferredmall</groupId>
            <artifactId>mall-security</artifactId>
        </dependency>

        <!-- 业务依赖：下单编排要注入 user / product / coupon -->
        <dependency>
            <groupId>com.preferredmall</groupId>
            <artifactId>mall-user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.preferredmall</groupId>
            <artifactId>mall-product</artifactId>
        </dependency>
        <dependency>
            <groupId>com.preferredmall</groupId>
            <artifactId>mall-coupon</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.preferredmall</groupId>
            <artifactId>mall-payment</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>
</project>
